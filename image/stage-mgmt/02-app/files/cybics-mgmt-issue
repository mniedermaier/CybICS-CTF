#!/usr/bin/python3
"""
Show how to reach CybICS-mgmt on the console login screen (HDMI), including
the admin password: whoever sits at the console has the SD card anyway.
Run by cybics-mgmt-issue.service once the containers are up.
"""
import os
import re
import time

AP_PROFILE = "/etc/NetworkManager/system-connections/cybics-mgmt-ap.nmconnection"
PASSWORD_FILE = "/var/lib/docker/volumes/cybics-mgmt_data/_data/admin_password"
ENV_FILE = "/opt/cybics-mgmt/.env"
PROBLEMS_FILE = "/run/cybics-mgmt/config-problems"
ISSUE = "/etc/issue.d/cybics-mgmt.issue"


def read(path):
    try:
        with open(path, encoding="utf-8") as f:
            return f.read()
    except OSError:
        return ""


def main():
    profile = read(AP_PROFILE)
    ssid = (re.search(r"(?m)^ssid=(.*)$", profile) or [None, "?"])[1]
    psk = (re.search(r"(?m)^psk=(.*)$", profile) or [None, "?"])[1]
    if "MGMT_ADMIN_PASSWORD=" in read(ENV_FILE):
        password = "(as set in cybics-mgmt.txt)"
    else:
        for _ in range(60):   # the server writes it at its first start
            password = read(PASSWORD_FILE).strip()
            if password:
                break
            time.sleep(2)
        password = password or "(not created yet; log in again in a minute)"
    problems = read(PROBLEMS_FILE).strip()
    text = (
        "\n  CybICS-mgmt\n"
        f"  Wi-Fi     {ssid}   password {psk}\n"
        "  Web       http://10.42.0.1   or   http://cybics-mgmt.local\n"
        f"  Admin     {password}\n"
        "  Settings  cybics-mgmt.txt on the SD card's boot partition\n"
    )
    if problems:
        text += "\n  Problems in cybics-mgmt.txt:\n" + "".join(f"    {p}\n" for p in problems.splitlines())
    os.makedirs(os.path.dirname(ISSUE), exist_ok=True)
    with open(ISSUE, "w", encoding="utf-8") as f:
        f.write(text.replace("\\", "\\\\") + "\n")


if __name__ == "__main__":
    main()
