# CybICS-CTF configuration for docker compose.
#
#   cp .env.example .env      # then edit .env; it is gitignored
#   docker compose up -d --build
#
# Every line is optional. Commented-out lines show the default. The full
# description of each setting is in the README, section "Configuration".

# ---------- access ----------

# Admin password, at least 8 characters. Left unset (recommended), a strong
# one is generated on first start; read it with
#   docker compose exec ctf-server cat /data/admin_password
# Never leave a value copied from an example in here.
# CTF_ADMIN_PASSWORD=

# Accept an admin password shorter than 8 characters. Local tests only, never
# for an event; the server logs a warning at every start.
# CTF_ALLOW_WEAK_ADMIN_PASSWORD=0

# Session key, at least 16 characters. Leave unset to have one generated and
# kept in /data/secret_key (recommended).
# CTF_SECRET_KEY=

# Admin sessions end after this many hours.
# CTF_ADMIN_SESSION_HOURS=12

# ---------- server ----------

# Name shown in the UI and returned by /api/v1/info.
# CTF_SERVER_NAME=CybICS CTF

# Where organisers reach the server; used in the links "login-link" prints.
# CTF_PUBLIC_URL=https://ctf.example.org

# Seconds between instance check-ins, and how long an instance counts as online.
# CTF_HEARTBEAT_INTERVAL=30
# CTF_ONLINE_WINDOW=90

# CTF_LOG_LEVEL=INFO

# ---------- network ----------

# Where the port is published. Docker publishes ports past host firewalls such
# as ufw: use 127.0.0.1 if only this machine (or a proxy on it) should connect.
# CTF_BIND=0.0.0.0
# CTF_PORT=8000

# Behind an outer TLS proxy (Caddy, Traefik) on the same host, set its address
# as nginx sees it (the gateway of the network below) and secure cookies:
# CTF_BIND=127.0.0.1
# CTF_OUTER_PROXY=172.29.84.1
# CTF_SECURE_COOKIES=1

# The stack's internal network; change it if it collides with a local one.
# CTF_SUBNET=172.29.84.0/24
# CTF_PROXY_IP=172.29.84.2
# CTF_APP_IP=172.29.84.3

# ---------- limits ----------
# All per-address limits count only bad requests; see "Shared addresses" in
# docs/ARCHITECTURE.md before tightening them for a classroom behind one NAT.

# Wrong team passwords per address per minute (0 switches the guard off).
# CTF_RATE_ENROLL=60

# New teams one address may create per 10 minutes.
# CTF_RATE_NEW_TEAMS=100

# Requests per instance per minute.
# CTF_RATE_HEARTBEAT=30
# CTF_RATE_SOLVE=30

# Failed admin logins per address per 5 minutes.
# CTF_RATE_LOGIN=10
